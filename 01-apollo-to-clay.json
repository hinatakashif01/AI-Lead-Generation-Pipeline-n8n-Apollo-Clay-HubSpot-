      "name": "Split Out People"
    },
    {
      "parameters": {
        "jsCode": "// Trim Apollo's person object down to what the scoring LLM actually needs.\n// Decision: smaller payload = cheaper tokens + less noise = more consistent scores.\nconst people = $input.all().map(i => i.json);\n\nfunction cleanPerson(p) {\n  return {\n    first_name: p.first_name,\n    last_name: p.last_name,\n    title: p.title,\n    headline: p.headline,\n    linkedin_url: p.linkedin_url,\n    city: p.city,\n    state: p.state,\n    country: p.country,\n    email_status: p.email_status,\n    seniority: p.seniority,\n    departments: p.departments,\n    organization: p.organization ? {\n      name: p.organization.name,\n      industry: p.organization.industry\n    } : null,\n    employment_history: (p.employment_history || []).map(e => ({\n      title: e.title,\n      organization_name: e.organization_name,\n      start_date: e.start_date,\n      end_date: e.end_date\n    })),\n    education: (p.education || []).map(ed => ({\n      school: ed.school_name || ed.name,\n      degree: ed.degree,\n      field: ed.field_of_study,\n      start_date: ed.start_date,\n      end_date: ed.end_date\n    }))\n  };\n}\n\nreturn people.map((p, idx) => ({\n  json: {\n    name: `profile_${idx + 1}`,\n    apollo_id: p.id,\n    data: [cleanPerson(p)]\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -192,
        432
      ],
      "id": "048f8139-c74f-4eb3-9efa-3347944f84ac",
      "name": "Clean Profile for LLM"
