      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"Lovare Institut Outreach Schema\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"profile_summary\": {\n      \"type\": \"string\",\n      \"description\": \"3–4 sentence summary of the candidate's academic and professional background, contextualized for law school readiness.\"\n    },\n    \"email\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"subject\": {\n          \"type\": \"string\",\n          \"description\": \"Personalized subject line for the email.\"\n        },\n        \"body\": {\n          \"type\": \"string\",\n          \"description\": \"Body of the outreach email introducing Lovare and inviting conversation.\"\n        }\n      },\n      \"required\": [\"subject\", \"body\"],\n      \"additionalProperties\": false\n    },\n    \"linkedin_message\": {\n      \"type\": \"string\",\n      \"description\": \"Short connection or follow-up message written for LinkedIn.\"\n    },\n    \"call_script\": {\n      \"type\": \"string\",\n      \"description\": \"Concise 30-second cold call script for the candidate.\"\n    }\n  },\n  \"required\": [\"profile_summary\", \"email\", \"linkedin_message\", \"call_script\"],\n  \"additionalProperties\": false\n}",
